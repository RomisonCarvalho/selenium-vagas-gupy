# Variáveis usadas na execução local.
# Não utilize espaços ao redor do "=".

# E-mail usado para enviar as notificações
EMAIL_REMETENTE=

# Senha de app do Gmail, informada sem espaços
EMAIL_SENHA_APP=

# E-mail que receberá as notificações
EMAIL_DESTINATARIO=

# Endpoint de cadastro da API
API_URL=

# Chave usada no header X-API-Key
API_KEY=