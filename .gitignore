# Ambientes virtuais
# Mantém dependências e arquivos específicos da máquina fora do repositório.
.venv/
venv/
env/
ENV/

# Cache e bytecode gerados automaticamente pelo Python
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebooks e checkpoints
# Os notebooks foram utilizados apenas durante prototipagem/estudos locais.
.ipynb_checkpoints/
*.ipynb

# Configurações locais de IDE/editor
.vscode/
.idea/
*.code-workspace

# Variáveis de ambiente e arquivos sensíveis
# Ignora arquivos .env reais, mas permite versionar o modelo .env.example.
.env
.env.*
!.env.example

# Caches de ferramentas de teste, tipagem e lint
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Artefatos gerados por build/empacotamento Python
build/
dist/
*.egg-info/

# Artefatos locais e legados da automação
# CSV e arquivos de log eram utilizados em versões anteriores do projeto.
reports/
logs/
*.csv
*.log

# Arquivos criados automaticamente pelo sistema operacional
.DS_Store
Thumbs.db
