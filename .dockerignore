# Cache e bytecode Python
# Não são necessários para construir ou executar a aplicação no container.
__pycache__/
*.py[cod]
*$py.class
*.so

# Ambientes virtuais locais
# O container instala suas próprias dependências a partir do requirements.txt.
.venv/
venv/
env/
ENV/

# Variáveis de ambiente e secrets
# Nenhum arquivo .env deve ser incorporado à imagem Docker.
.env
.env.*

# Configurações locais de IDE/editor
.vscode/
.idea/
*.code-workspace

# Metadados do Git
# O histórico do repositório não é necessário dentro da imagem.
.git/
.github/

# Caches de ferramentas de desenvolvimento
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Artefatos de build Python
build/
dist/
*.egg-info/

# Artefatos locais e legados
# CSVs e arquivos de log não fazem parte da persistência atual da aplicação.
reports/
logs/
*.csv
*.log

# Arquivos do sistema operacional
.DS_Store
Thumbs.db

# Documentação e metadados do repositório não necessários em runtime
README.md
.gitattributes
.gitignore
